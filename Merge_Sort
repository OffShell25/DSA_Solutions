class Solution {
public:
    vector<int> mergeSort(vector<int>& nums) {
        vector<int>v1;
        if(nums.size()==1){
            return nums;
        }
    
        for(int i=0; i<(nums.size())/2;i++){
            
            v1.push_back(nums[i]);
        }
        
        vector<int>v2;
         for(int j=(nums.size())/2; j<=nums.size()-1;j++){
            
            v2.push_back(nums[j]);
        }
    
        v1 = mergeSort(v1);
        
        v2 = mergeSort(v2);
        vector<int>temp;
        int i =0;
        int j =0;
        while(i < v1.size() && j<v2.size()){
            if(v1[i]>v2[j]){
                temp.push_back(v2[j]);
                j++;
            }else{
                temp.push_back(v1[i]);
                i++;
            }
        }
        while(i < v1.size()){
            temp.push_back(v1[i]);
                i++;
        }
         while(j < v2.size()){
            temp.push_back(v2[j]);
                j++;
        }
        return temp;

    }
};
