class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int n = nums.size();
        
        // Step 1: Find the breakpoint (the '2' in 25431)
        // We walk from right to left looking for the first drop in value.
        int breakpoint = -1;
        for (int i = n - 2; i >= 0; i--) {
            if (nums[i] < nums[i + 1]) {
                breakpoint = i;
                break;
            }
        }
        
        // If we never found a breakpoint, the entire array is descending.
        // It has peaked (e.g., 54321). The problem says to just return the lowest order.
        if (breakpoint == -1) {
            reverse(nums.begin(), nums.end());
            return;
        }
        
        // Step 2: Swap the breakpoint with the smallest larger number 
        // We walk from right to left, the first number bigger than our breakpoint is the perfect upgrade.
        for (int j = n - 1; j > breakpoint; j--) {
            if (nums[j] > nums[breakpoint]) {
                swap(nums[breakpoint], nums[j]);
                break; // Stop looking once we've made the swap
            }
        }
        
        // Step 3: Reverse the right side
        // Everything to the right of the breakpoint is currently descending. 
        // We reverse it to make it ascending (the smallest possible arrangement).
        reverse(nums.begin() + breakpoint + 1, nums.end());
    }
};
