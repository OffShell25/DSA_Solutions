    int subarraySum(vector<int> &nums, int k){
        
        int count = 0;
       map<int,int>mp;
       mp[0]=1;
       int pre = 0;
       for(int i = 0;i<nums.size();i++){
         
        pre += nums[i];
        
        count += mp[pre-k];
        mp[pre]+=1;
        
       }
        return count;
    }
};
