class Solution {
  public:
    vector<vector<int>> mergeOverlap(vector<vector<int>>& arr) {
        sort(arr.begin(),arr.end());
        for(int i = 0; i < arr.size() - 1; i++){
            if(arr[i][1]>=arr[i+1][0]){
                 arr[i][1] = max(arr[i][1], arr[i + 1][1]);              
                arr.erase(arr.begin() + i+1);
                i--;
            }else{
                continue;
            }
            
        }
        
        return arr;
    }
};
