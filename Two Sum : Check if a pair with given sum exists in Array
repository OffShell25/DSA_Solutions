class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        vector<pair<int,int>> numswithindex;
        for(int i = 0;i<nums.size();i++){
            numswithindex.push_back({nums[i],i});
        }
        sort(numswithindex.begin(),numswithindex.end());
        int i = 0;
        int j = numswithindex.size()-1;
        while(i<j && j<numswithindex.size()){
            if(numswithindex[i].first+numswithindex[j].first == target ){
                return {numswithindex[i].second,numswithindex[j].second};

            }else if(numswithindex[i].first+numswithindex[j].first < target ){
                i++;
            }else{
                j--;
            }
        }
        return {-1,-1};
    }
};
